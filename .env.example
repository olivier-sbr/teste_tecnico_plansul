# Copie este arquivo para .env e preencha com suas credenciais reais

# Destinatário do relatório
EMAIL_TO=destinatario@exemplo.com

# Credenciais SMTP
EMAIL_USER=seu_email@gmail.com
EMAIL_PASSWORD=sua_senha_de_app

# Servidor SMTP (padrão: Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# --- Mailtrap (para testes sem envio real) ---
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=seu_usuario_mailtrap
# EMAIL_PASSWORD=sua_senha_mailtrap
